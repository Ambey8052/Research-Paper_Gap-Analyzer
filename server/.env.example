# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
# Local Docker default (mongodb-atlas-local image, supports $vectorSearch just like real Atlas):
MONGODB_URI=mongodb://mongodb:27017/researchmind?directConnection=true
# For production, replace with a real Atlas connection string, e.g.:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/researchmind
VECTOR_INDEX_NAME=paper_vector_index

# Google Gemini (required — free tier, no credit card needed:
# get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Semantic Scholar (optional — works without a key at low rate limits;
# get a free key at https://www.semanticscholar.org/product/api to raise limits)
SEMANTIC_SCHOLAR_API_KEY=

# Pipeline tuning
MAX_PAPERS_PER_SEARCH=40
