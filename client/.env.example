# Used only by vite.config.js dev proxy — where the backend API lives during `npm run dev`.
VITE_API_PROXY_TARGET=http://localhost:5000

# Production builds only (e.g. deploying the client to Vercel while the server lives
# elsewhere, like Render). Leave unset for the Docker/nginx deployment, where nginx
# proxies same-origin /api to the server container instead.
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
